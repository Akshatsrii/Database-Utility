# Database Connection Strings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=mydb

# Google Drive Storage Integration
# ID of the Google Drive folder where backups should be uploaded.
GDRIVE_FOLDER_ID=your_google_drive_folder_id

# Note: For Google Drive integration, you also need to place your 
# Service Account JSON key file in the root directory named:
# google-service-account.json
