# Database Connection Strings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=mydb

# Google Drive Storage Integration
# ID of the Google Drive folder where backups should be uploaded.
GDRIVE_FOLDER_ID=your_google_drive_folder_id

# Google Cloud credentials
# google-service-account.json

# Slack Notifications
# Webhook URL for sending backup success/failure notifications to a Slack channel.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
